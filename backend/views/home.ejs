        position: relative;
      } */
      .profile {
        position: absolute;
        top: 35px;
        right: 30px;
        display: flex;
        align-items: center;
      }
      .profile img {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        margin-right: 10px;
      }
      /* .post-container {
        max-width: 800px;
        margin: 2rem auto;
        padding: 1rem;
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      } */
      /* .post {
        margin-bottom: 2rem;
        padding: 1rem;
        border-bottom: 1px solid #ddd;
      } */
      .post:last-child {
        border-bottom: none;
      }
      /* h2 {
        color: #333;
      } */
      /* p {
        color: #555;
      } */
      /* .genre {
        color: #888;
