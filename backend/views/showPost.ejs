<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %></title>
</head>
<body>
    <div class="post-container">
        <% if (post) { %>
            <div class="post">
                <h1><%= post.title %></h1>
                <p class="genre">Genre: <%= post.genre %></p>
                <p class="author">Author: <%= post.author ? post.author.name : "Unknown" %></p>
                <p class="content"><%= post.content %></p>
            </div>
        <% } else { %>
            <p>Post not found.</p>
        <% } %>
    </div>
</body>
</html>