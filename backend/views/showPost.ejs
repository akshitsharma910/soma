
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= post.title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
    <style>
      body {
        margin: 0;
        padding: 0;
        height: 100vh; /* Ensure body takes full viewport height */
      }
      .post-title {
        font-size: 2rem;
        font-weight: bold;
      }
      .post-meta {
        font-size: 0.9rem;
        color: #6c757d;
      }
      .post-content {
        margin-top: 20px;
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar') %>
    <div class="col-4"><%- include('partials/sidebar') %></div>

    <div class="post-container mt-5 container col-5">
      <% if (post) { %>
      <div class="post">
        <h1><%= post.title %></h1>
        <p class="genre">Genre: <%= post.genre %></p>
        <p class="author">
          Author: <%= post.author ? post.author : "Unknown" %>
        </p>
        <p class="content"><%= post.content %></p>

        <% if (user && post.author && user.id === post.authorId) { %>
        <button
          onclick="deletePost('<%= post.id %>')"
          class="btn btn-outline-secondary"
        >
          Delete Post
        </button>
        <% } %>
      </div>
      <% } else { %>
      <p>Post not found.</p>
      <% } %>
    </div>

    <div class="container mt-3 post-container col-5 mt-5 py-3 border-top">
      <h3 class="text-secondary" id="comment-length">Comments (<%= comments.length %>)</h3>

      <% if (user) { %>
      <form action="/posts/<%= post.id %>/comment" method="post">
        <div class="mb-3 row align-items-center">
          <div class="form-floating col-9">
            <textarea
              name="content"
              class="form-control"
              placeholder="Leave a comment here"
              id="floatingTextarea2"
              style="height: 100px"
            ></textarea>
            <label for="floatingTextarea2" class="ms-2"
              >Add your opinion...</label
            >
          </div>

          <button class="btn btn-sm btn-primary mx-4 col-2" type="submit">
            Add
          </button>
        </div>
      </form>
      <% } %>

      <div class="mt-3">
        
        <% comments.forEach(comment => { %>
        <div class="comment" id="comment-<%= comment.id %>">
          <img
            src="https://github.com/mdo.png"
            alt=""
            width="32"
            height="32"
            class="rounded-circle me-2"
          />
          <strong
            ><%= comment.author ? comment.author : "Unknown User" %></strong
          >
          <pre class="ms-5"><%= comment.content %></pre>
          <% if (comment.author && comment.id && user && user.id &&
          comment.authorId === user.id) { %>
          <button
            class="btn btn-danger btn-sm"
            onclick="deleteComment('<%= comment.id %>','<%= post.id%>', '<%= comment.authorId %>')"
          >
            Delete
          </button>
          <% } %>
        </div>
        <% }) %>
      </div>
    </div>

    <script>
      function deletePost(postId) {
        if (confirm("Are you sure you want to delete this post?")) {
          fetch(`/posts/${postId}`, {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
          })
            .then((response) => {
              console.log(response.status);
              if (response.ok) {
                alert("Post deleted successfully!");
                window.location.href = "/";
              } else {
                alert("Failed to delete post.");
              }
            })
            .catch((error) => console.error("Error:", error));
        }
      }
      
      function deleteComment(commentId, postId, authorId) {
        console.log(
          `Attempting to delete comment: ${commentId} from post: ${postId} with author ID: ${authorId}`
        );

        if (!confirm("Are you sure you want to delete this comment?")) return;

        fetch(`/posts/${postId}/comment/${commentId}`, {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          credentials: "include", // Ensures cookies are sent with the request
        })
          .then((response) => response.json()) // Parse JSON response
          .then((data) => {
            console.log("Server response:", data);

            if (data.message === "Comment deleted successfully") {
              document.getElementById(`comment-${commentId}`).remove();
              document.getElementById("comment-length").innerText = `Comments (${
                document.getElementsByClassName("comment").length
              })`;
              console.log(`Comment ${commentId} deleted successfully`);
            } else {
              alert(data.message || "Failed to delete comment.");
            }
          })
          .catch((error) => console.error("Error:", error));
      }
    </script>
  </body>
</html>
