<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Posts</title>
  </head>
  <body>
    <%- include('partials/head') %> <%- include('partials/navbar') %> <%-
    include('partials/sidebar') %>

    <h1 class="container">My Posts</h1>

    <div class="post-container d-block container col-7 mt-5">
      <% if (posts.length > 0) { %> <% posts.forEach(post => { %>
      <div class="post mb-4 p-3 border-bottom heading-container">
        <a
          href="/posts/<%= post.id %>"
          class="text-dark"
          style="text-decoration: none"
        >
          <div class="border-bottom row mb-4 pt-4">
            <h4><%= post.title %></h4>
            <p class="genre fs-6 lead container col text-muted">
              Genre: <%= post.genre %>
            </p>
            <p class="author fs-6 lead col small text-muted">
              Author: <%= post.author ? post.author : "Unknown" %>
            </p>
            <% if (user && post.authorId === user.id) { %>
                <div class="col-1">
                  <button
                    class="delete-btn btn btn-outline-danger"
                    onclick="deletePost('<%= post.id %>')"
                  >
                    Delete
                  </button>
                </div>
                <% } %>
          </div>
          <p><%= post.content %></p>
        </a>
      </div>
      <% }) %> <% } else { %>
      <p>You haven't written any posts yet.</p>
      <% } %>
    </div>

    <script>
      function deletePost(postId) {
        if (confirm("Are you sure you want to delete this post?")) {
          fetch(`/posts/${postId}`, {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            credentials: "include",
          })
            .then((response) => {
              if (response.ok) {
                alert("Post deleted successfully!");
                window.location.reload();
              } else {
                alert("Failed to delete post.");
              }
            })
            .catch((error) => console.error("Error:", error));
        }
      }
    </script>
  </body>
</html>
