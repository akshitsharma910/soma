    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Add Post - Soma</title>
        <style>
            body {
                font-family: Arial, sans-serif;
                margin: 0;
                padding: 0;
                background-color: #f4f4f9;
            }
            header {
                background-color: #4a90e2;
                color: white;
                padding: 1rem;
                text-align: center;
            }
            .form-container {
                max-width: 600px;
                margin: 2rem auto;
                background: white;
                padding: 2rem;
                border-radius: 8px;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            }
            h1 {
                text-align: center;
                color: #333;
            }
            form {
                display: flex;
                flex-direction: column;
            }
            label {
                font-weight: bold;
                margin-top: 1rem;
                color: #555;
            }
            input, textarea, select {
                margin-top: 0.5rem;
                padding: 0.75rem;
                border: 1px solid #ddd;
                border-radius: 4px;
                font-size: 1rem;
            }
            textarea {
                resize: vertical;
                height: 150px;
            }
            button {
                margin-top: 1.5rem;
                padding: 0.75rem;
                background-color: #4a90e2;
                color: white;
                border: none;
                border-radius: 4px;
                font-size: 1rem;
                cursor: pointer;
                transition: background-color 0.2s;
            }
            button:hover {
                background-color: #357abd;
            }
        </style>
    </head>
    <body>
        <header>
            <h1>Add a New Post</h1>
        </header>
        <div class="form-container">
            <form action="/posts/add" method="POST">
                <label for="title">Title</label>
                <input type="text" id="title" name="title" required> <!-- Matches the schema -->
            
                <label for="content">Content</label>
                <textarea id="content" name="content"></textarea> <!-- Optional -->
            
                <label for="genre">Genre</label>
                <select id="genre" name="genre" required> <!-- Matches the schema -->
                    <option value="">Select a genre</option>
                    <option value="Fiction">Fiction</option>
                    <option value="Non-Fiction">Non-Fiction</option>
                    <option value="Poetry">Poetry</option>
                </select>
             
            
                <button type="submit">Submit</button>
            </form>
            
        </div>
    </body>
    </html>
